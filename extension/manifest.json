{
  "manifest_version": 3,
  "name": "NALE: Neuro-Adaptive Learning Ecosystem",
  "version": "2.0",
  "description": "Ambient intelligence platform that monitors biometric telemetry and dynamically alters web UIs.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/intervention.js", "content/telemetry.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["permissions.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
